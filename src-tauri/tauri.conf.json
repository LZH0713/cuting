{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuting",
  "version": "0.1.4",
  "identifier": "com.liangzhihong.cuting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LZH0713/cuting/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NzdERjM1Q0NDNTA5QjAKUldTd0NjWE1OZDkzV1lQbldOem9icTFvQ25CSzdxZ3ZiblMrRGZKSTZNa25pVWMxWnRjUTVac1EK"
    }
  }
}
